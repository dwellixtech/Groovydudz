APP_ENV=development
API_HOST=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

DEFAULT_STORE_SLUG=groovydudz

RESEND_API_KEY=
RESEND_FROM_EMAIL=GroovyDudz <orders@groovydudz.com>

# Where PayU returns the shopper after payment (the storefront, not the API).
STOREFRONT_URL=http://localhost:5173

# PayU India — PAYU_ENV=test uses test.payu.in, production uses secure.payu.in
PAYU_ENV=test
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=

# Delhivery (production: https://track.delhivery.com, staging: https://staging-express.delhivery.com)
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_API_TOKEN=
# Warehouse name exactly as registered in Delhivery One
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_SHIPPING_MODE=Surface
DELHIVERY_DEFAULT_WEIGHT_GRAMS=500
DELHIVERY_SELLER_NAME=GroovyDudz
DELHIVERY_SELLER_GST_TIN=

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=
